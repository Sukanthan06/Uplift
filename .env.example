DATABASE_URL=postgresql+psycopg://uplift:uplift@localhost:5433/uplift
GROQ_API_KEY=gsk_xxxx
GROQ_MODEL=openai/gpt-oss-120b
POLICY_VERSION=v1

# Action service backend. Options: mock | razorpay_test | off
# mock (default): deterministic, no external calls.
# razorpay_test: real HTTP to Razorpay's sandbox -- requires a TEST-mode
#   key (must start with rzp_test_; live keys are rejected at startup).
# off: shadow mode, logs the intended action, calls nothing.
ACTION_MODE=mock
RAZORPAY_API_KEY=rzp_test_xxxx
RAZORPAY_API_SECRET=xxxx
RAZORPAY_TEST_ENDPOINT=https://api.razorpay.com/v1

ENV=development
